# ═══════════════════════════════════════════════════
# METRIC — Configuration (`API-02`)
# ═══════════════════════════════════════════════════
# Copier en `.env` à la racine, puis renseigner. Aucun secret ne doit apparaître
# ailleurs : ni dans le code, ni côté client, ni dans un CSV.
#
#   cp .env.example .env
#
# Toutes les valeurs ci-dessous ont un repli qui permet à l'application de démarrer
# sans configuration. Ce qui n'est pas configuré est annoncé comme indisponible —
# jamais deviné, jamais simulé.

# ── Service ────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# Fuseau de découpage des journées (`HEAT-32`). Jamais UTC : une prise à 23 h 30
# appartient au jour affiché par l'horloge, pas au lendemain.
TIMEZONE=Europe/Paris

# ── Stockage Nextcloud / WebDAV (`STO-01`) ─────────
# Le backend est le seul détenteur de ces identifiants.
# Utiliser un mot de passe d'application Nextcloud, pas le mot de passe du compte.
# Vérifier la configuration avant de lancer l'API : `make check-storage` (lot L01).
NEXTCLOUD_URL=https://nextcloud.exemple.fr/remote.php/dav/files/aleksi
NEXTCLOUD_USERNAME=
NEXTCLOUD_PASSWORD=
# Dossier racine des données, sous le répertoire de l'utilisateur.
NEXTCLOUD_ROOT=Metric

# ── Authentification (`AUTH-01` → `AUTH-03`) ───────
AUTH_USERNAME=aleksi
# Hash Argon2id — jamais de mot de passe en clair (`AUTH-02`).
# Générer avec : `make hash-password` (lot L02, `AUTH-08`).
AUTH_PASSWORD_HASH=

# Signature des jetons de session. Générer une valeur longue et unique :
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_TTL_DAYS=7

# ── CORS (`API-03`) ────────────────────────────────
# Origines autorisées, séparées par des virgules. Dev local + domaine de production.
# En production, doit porter l'adresse HTTPS publique : le symptôme d'un oubli est un
# écran qui charge indéfiniment, sans erreur visible.
CORS_ORIGINS=http://localhost:5173

# Derrière un reverse-proxy — Nginx Proxy Manager (`OPS-01`) —, l'adresse de l'appelant
# est dans `X-Forwarded-For`. Sans ce réglage, l'anti-brute-force (`AUTH-04`) voit
# l'adresse du proxy et non celle de l'appelant : cinq échecs bloquent alors **tout le
# monde**. Avec lui et sans proxy devant, l'en-tête est forgeable et la garde ne protège
# plus rien — d'où le défaut à faux, et le fait que ce soit un choix explicite.
TRUST_PROXY_HEADERS=false

# ── IA OpenRouter (`IA-01`, `IA-07`) ───────────────
# Facultatif. Sans clé, l'application fonctionne intégralement en saisie manuelle et
# les fonctions IA renvoient un message clair. L'IA est un confort, jamais un prérequis.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Modèle préféré ; vide = découverte automatique des modèles gratuits (`IA-02`).
OPENROUTER_MODEL=

# ── Export iCal (`PLAN-05`) ────────────────────────
# Clé du flux `.ics` abonnable. Stable : la changer casse les abonnements existants.
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
ICAL_SECRET=

# ── Dossier médical (`docs/dossier-medical.md`) ──
# Le dossier est chiffré par l'application avant d'aller sur Nextcloud. Sans clé, il est
# fermé. Perdue, la clé rend le dossier illisible : recopie-la sur papier.
#   make medical-key
MEDICAL_KEY=

# ── Garmin Connect, voie non officielle (`docs/synchro-garmin.md`) ──
# Facultatif. Garmin n'ouvre plus son API : la synchro passe par la bibliothèque
# `garminconnect` et tes identifiants. Elle peut casser ou faire bloquer le compte —
# l'import d'un `.fit` reste toujours possible. Installer : .venv/bin/pip install garminconnect
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_TOKEN_DIR=.garmin

# ── Notifications push (`NOT-01`) ──────────────────
# Paire de clés Web Push (RFC 8292). Sans elle, aucun abonnement n'est proposé et
# l'ordonnanceur des rappels ne démarre pas — le reste de l'application est intact.
#
#   make vapid-keys
#
# La publique part au navigateur : elle est faite pour être vue. La privée signe chaque
# envoi et ne sort pas d'ici.
#
# ATTENTION : changer de paire invalide les abonnements existants. Un abonnement est lié
# à la clé publique qui l'a créé ; les appareils déjà enregistrés continueraient d'exister
# côté service push et tous les envois seraient refusés, sans rien pour le signaler. Il
# faut alors vider `notifications/subscriptions.csv` et se réabonner.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Identité de l'exploitant, exigée par la RFC : `mailto:` ou `https:`. Un service push la
# lit pour joindre quelqu'un quand un envoi se comporte mal.
VAPID_SUBJECT=mailto:
